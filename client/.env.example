# Backend API Base URL
VITE_API_URL=https://your-api-domain.vercel.app/api/technotech

# ImgBB Cloud Storage API Key
VITE_IMGBB_API_KEY=your_imgbb_api_key

# Cloudflare Turnstile Site Key
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Admin TOTP Secret (set only via env, never commit real secret)
VITE_ADMIN_TOTP_SECRET=your_base32_totp_secret
